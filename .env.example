# Khoá API Gemini (bắt buộc – dùng cho gia sư AI và soạn đề tự động)
GEMINI_API_KEY=

# Tài khoản Gmail gửi mã OTP (dùng App Password 16 ký tự, không phải mật khẩu thường)
GMAIL_USER=
GMAIL_PASS=

# Service account của Firebase (bắt buộc để server chấm bài, cộng điểm bài học, tính LP).
# Firebase Console → Project settings → Service accounts → Generate new private key,
# rồi dán TOÀN BỘ nội dung file JSON trên một dòng.
FIREBASE_SERVICE_ACCOUNT=

# (Tuỳ chọn) Firebase project ID dùng để xác thực ID token phía server.
# Mặc định đọc từ firebase-applet-config.json
FIREBASE_PROJECT_ID=

# (Tuỳ chọn) Cổng server, mặc định 3000
PORT=3000
