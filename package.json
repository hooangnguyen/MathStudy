{
  "name": "mathstudy",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "tsx server.ts",
    "dev:server": "tsx --watch server.ts",
    "dev:client": "vite",
    "build": "vite build",
    "start": "cross-env NODE_ENV=production tsx server.ts",
    "preview": "vite preview",
    "clean": "rm -rf dist",
    "lint": "tsc --noEmit",
    "test:e2e": "cross-env VITE_FIREBASE_EMULATORS=true vite build --outDir dist-e2e && npx -y firebase-tools@14 emulators:exec --only auth,firestore --project $(node -p \"require('./firebase-applet-config.json').projectId\") \"bash tests/e2e/run.sh\"",
    "migrate:answer-keys": "tsx scripts/migrate-answer-keys.ts",
    "test": "vitest run",
    "test:emulator": "npx -y firebase-tools@14 emulators:exec --only auth,firestore --project demo-mathstudy \"node tests/emulator/run.mjs\""
  },
  "dependencies": {
    "@google/genai": "^1.29.0",
    "@tailwindcss/vite": "^4.1.14",
    "@types/canvas-confetti": "^1.9.0",
    "@types/katex": "^0.16.8",
    "@vitejs/plugin-react": "^5.0.4",
    "canvas-confetti": "^1.9.4",
    "clsx": "^2.1.1",
    "compression": "^1.8.2",
    "cross-env": "^10.1.0",
    "dotenv": "^17.3.1",
    "express": "^4.21.2",
    "firebase": "^12.10.0",
    "firebase-admin": "^14.5.0",
    "katex": "^0.16.45",
    "lucide-react": "^0.546.0",
    "mathlive": "^0.108.3",
    "motion": "^12.23.24",
    "nodemailer": "^8.0.1",
    "react": "^19.0.0",
    "react-markdown": "^10.1.0",
    "recharts": "^3.7.0",
    "rehype-katex": "^7.0.1",
    "remark-math": "^6.0.0",
    "tailwind-merge": "^3.5.0",
    "tsx": "^4.21.0",
    "vite": "^6.2.0"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^5.0.2",
    "@types/compression": "^1.8.1",
    "@types/express": "^4.17.21",
    "@types/node": "^22.14.0",
    "@types/nodemailer": "^7.0.11",
    "@types/react-dom": "^19.2.3",
    "autoprefixer": "^10.4.21",
    "playwright-core": "^1.63.0",
    "react-dom": "^19.2.5",
    "tailwindcss": "^4.1.14",
    "ts-node": "^10.9.2",
    "typescript": "~5.8.2",
    "vite": "^6.2.0",
    "vite-plugin-pwa": "^1.3.0",
    "vitest": "^4.1.6"
  }
}
